# Cache and security headers for Netlify. Honoured on zip and drag-and-drop
# deploys; netlify.toml carries the same rules for git-based deploys. Keep in sync.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# Images and CSS/JS never change under the same name, so cache them hard. This is
# the fix for the live site's `max-age=0, must-revalidate` on every asset.
/img/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must revalidate, or a deploy won't be picked up.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
